<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal Nieruchomściowy</title>
    <link rel="stylesheet" href="~/css/Login.css" />
    <link rel="stylesheet" href="~/css/font/css/fontello.css">

</head>
<body>
    <div id="container">
        <div id="tlo">
            <header>
                <a href="#" class="logo">Logo</a>
               
                <div id="rightNavlist">
                    <a href="@Url.Action("SellOrRent", "Home")"><div id="WstawOgloszenie">Dodaj ogłoszenie</div></a>
                </div>
            </header>
            <div id="Menu">
                <div id="NavMenu">
                    <button class="tab active">Zaloguj się</button>
                    <button class="tab" onclick="window.location.href='/Home/Register'">Zarejestruj</button>
                </div>

                <div class="google-login">
                    <a href="/auth/google" class="google-btn">
                        <i class="icon-google"></i> Zaloguj się przez Google
                    </a>
                </div>

                <form action="login" method="post">

                    <div class="input">
                        <i class="icon-mail-alt"></i>
                        <input type="email" placeholder="Podaj email" name="email" required>
                    </div>

                    <div class="input">
                        <i class="icon-lock"></i>
                        <input type="password" placeholder="Podaj hasło" name="password" required>
                    </div>

                    <p class="bez-hasla"><a href="@Url.Action("ForgotPassword", "Home")">Nie pamiętasz hasła?</a></p>

                    <input type="submit" value="Zaloguj się">

                    <p class="register-link">Nie masz jeszcze konta? <a href="@Url.Action("Register", "Home")">Zarejestruj się!</a></p>
                </form>
            </div>


        </div>
    </div>
</body>
</html>
